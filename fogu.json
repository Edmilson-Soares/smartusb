{
  "name": "smartusb",
  "version": "0.2.0",
  "engines": { "fogu": ">=0.8.0" },
  "entry": "main.fg",
  "scripts": {
    "start": "fogu run main.fg",
    "dev": "fogu --watch main.fg",
    "test": "fogu test",
    "build:native": "powershell -ExecutionPolicy Bypass -File build.ps1",
