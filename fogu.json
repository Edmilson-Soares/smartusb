    "build:all": "sh build.sh all",
    "usbids": "powershell -ExecutionPolicy Bypass -File usbids.ps1",
    "cartao": "fogu run examples/cartao.fg",
    "barcode": "fogu run examples/barcode.fg",
    "pendrive": "fogu run examples/pendrive.fg"
  },
  "dependencies": {}
}
